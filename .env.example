# Local development uses SQLite; switch to a Postgres URL when deploying.
DATABASE_URL="file:./dev.db"

# Password for the HR dashboard at /admin. Change this before real use.
ADMIN_PASSWORD="change-me"

# Signs the admin session cookie. Generate with: openssl rand -hex 32
# Changing this signs everyone out.
SESSION_SECRET="replace-with-a-random-64-character-hex-string"
